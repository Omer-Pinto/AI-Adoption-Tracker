# macOS
.DS_Store
# tooling — ignore local Claude state, but DO track project skills (shared infra)
.claude/*
!.claude/skills/
.claude/skills/*/*-workspace/
# python
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm
*.db.bak
# db backups with any suffix (e.g. tracker.db.bak-loginfix-YYYYMMDD) — never commit the DB
tracker.db*
*.bak-*
.venv/
# node / frontend
node_modules/
dist/
# secrets
.env

# Playwright MCP browser artifacts (throwaway)
.playwright-mcp/
