{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-adoption-tracker/report_schema.json",
  "title": "Weekly Report",
  "description": "The §4 weekly-report document. One report = one meeting with one champion, covering all their domains. This same schema does three jobs: form layout, save-time validation, and the contract the LLM drafts notes against.",
  "type": "object",
  "additionalProperties": false,
  "required": ["champion", "meeting_date", "raw_notes"],
  "properties": {
    "champion": {
      "type": "string",
      "description": "Champion name for this meeting."
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "ISO-8601 date (YYYY-MM-DD) of the meeting."
    },
    "participants": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "raw_notes": {
      "type": "string",
      "description": "The raw meeting notes pasted verbatim; kept inside the report."
    },
    "domains": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/domainSection" }
    },
    "action_items": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/actionItem" }
    },
    "discussion": { "type": ["string", "null"] },
    "issues": { "type": ["string", "null"] }
  },
  "$defs": {
    "taskStatus": {
      "type": "string",
      "enum": [
        "planned",
        "in-progress",
        "finished_successfully",
        "finished_with_issues",
        "blocked",
        "abandoned"
      ]
    },
    "artifactType": {
      "type": "string",
      "enum": ["agent", "skill", "hook", "context"]
    },
    "artifactChangeKind": {
      "type": "string",
      "enum": ["added", "updated", "retired", "moved"]
    },
    "domainSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string" },
        "changes": {
          "description": "Only the domain fields that changed this meeting; omit if none.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "priority": { "type": "string" }
          }
        },
        "tasks": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/taskEntry" }
        },
        "artifacts": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/artifactEntry" }
        }
      }
    },
    "taskEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "A task line. `task` is the task name; whether it already exists is resolved against the DB at fan-out time — existing name → that row; unknown name → created.",
      "required": ["task", "status"],
      "properties": {
        "task": { "type": "string", "description": "The task's name." },
        "status": { "$ref": "#/$defs/taskStatus" },
        "owner": { "type": "string" },
        "note": { "type": "string" },
        "finished_on": {
          "type": "string",
          "format": "date",
          "description": "Optional per-task finish-date override (YYYY-MM-DD). When the task reaches a terminal status, ended_on is set to this value if present, otherwise to the report's meeting_date. The engine never auto-computes ended_on from status history."
        }
      }
    },
    "artifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "An artifact change line. `artifact` is the artifact name; whether it already exists is resolved against the DB at fan-out time — existing name → that row; unknown name → created (requires `type`).",
      "required": ["artifact"],
      "properties": {
        "artifact": { "type": "string", "description": "The artifact's name." },
        "type": { "$ref": "#/$defs/artifactType" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "change_kind": { "$ref": "#/$defs/artifactChangeKind" },
        "note": { "type": "string" }
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "owner": { "type": "string" },
        "domain": { "type": "string" },
        "due_date": { "type": "string", "format": "date" }
      }
    }
  }
}
