# AI Adoption Tracker — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.
#
# DEPLOYMENT NOTE: This application runs in an AIR-GAPPED environment.
# It has no access to api.openai.com or api.anthropic.com.
# All LLM traffic goes to a self-hosted inference server on your network.
# There are no hosted-vendor defaults — you must supply all four LLM variables.

# ---------------------------------------------------------------------------
# LLM configuration — ALL FOUR ARE REQUIRED
# Unset or blank values for any of these four variables will cause the
# report-drafting endpoint to return HTTP 503 (LLM not configured).
# ---------------------------------------------------------------------------

# Wire format / API dialect of your inference server.
# "openai"    — server exposes an OpenAI Chat Completions-compatible API.
# "anthropic" — server exposes an Anthropic Messages-compatible API.
TRACKER_LLM_PROVIDER=openai

# Full base URL of the air-gapped inference server.
# Include the version path prefix your server uses (commonly /v1).
# No public-API fallback exists — this must point to your local server.
# Example: http://llm-host.internal:8080/v1
TRACKER_LLM_ENDPOINT=http://llm-host.internal:8080/v1

# Credential for the inference server (sent as Bearer token or x-api-key).
# Set to whatever your server requires; leave blank only if the server is
# completely unauthenticated (rare — blank will cause a 503 error).
TRACKER_LLM_API_KEY=

# Model name exactly as your inference server serves it.
# Examples: llama-3-70b, mistral-7b-instruct, mixtral-8x7b
# Do NOT use hosted model IDs (gpt-4o, claude-3-5-sonnet-*, etc.) — they
# are meaningless to a self-hosted server.
TRACKER_LLM_MODEL=your-model-name-here

# ---------------------------------------------------------------------------
# Optional LLM settings
# ---------------------------------------------------------------------------

# Request timeout in seconds (default 120).
# TRACKER_LLM_TIMEOUT=120

# Override the anthropic-version header sent when TRACKER_LLM_PROVIDER=anthropic.
# Default: 2023-06-01 (minimum stable version for the Messages API).
# Change this only if your OSS server requires a specific value.
# TRACKER_LLM_ANTHROPIC_VERSION=2023-06-01

# Structured-output strategy for schema-constrained generation (default: auto).
#
#   auto        — Try the best structured method first; fall back automatically
#                 when the server returns HTTP 400/422 indicating an unsupported
#                 parameter (e.g. a vLLM or llama.cpp server that does not yet
#                 implement json_schema response_format or tools).
#                 OpenAI dialect:  json_schema strict → json_object fallback.
#                 Anthropic dialect: forced tool-use → prefill+text fallback.
#
#   json_schema — (OpenAI dialect only) Force response_format=json_schema with
#                 strict:true. Falls back to json_object on 4xx rejection.
#                 Equivalent to "auto" for the anthropic dialect.
#
#   tool        — (Anthropic dialect only) Force forced-tool-use via emit_report.
#                 Falls back to prefill+text on 4xx rejection.
#                 Equivalent to "auto" for the openai dialect.
#
#   off         — Disable all structured-output mechanisms. Uses json_object
#                 (openai) or prefill+text (anthropic). Schema is described in
#                 the system prompt only. Use this if your server rejects all
#                 structured-output parameters and the auto fallback causes issues.
#
# TRACKER_LLM_STRUCTURED=auto
