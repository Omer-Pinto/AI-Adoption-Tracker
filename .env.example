# AI Adoption Tracker — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# LLM provider selection (required to create reports)
# ---------------------------------------------------------------------------

# Which LLM provider to use.
# Accepted values: openai  |  anthropic
TRACKER_LLM_PROVIDER=openai

# API key for the selected provider.
# OpenAI:    your sk-... key
# Anthropic: your sk-ant-... key
TRACKER_LLM_API_KEY=

# Model ID (optional — sensible defaults are used when blank).
# Default when provider=openai:     gpt-4o
# Default when provider=anthropic:  claude-3-5-sonnet-20241022
# TRACKER_LLM_MODEL=

# Base URL override — for air-gapped or proxied deployments only.
# When blank, the provider's public API URL is used:
#   openai:    https://api.openai.com/v1
#   anthropic: https://api.anthropic.com/v1
# Set this only if you are routing through a local proxy or air-gapped mirror.
# TRACKER_LLM_ENDPOINT=

# Request timeout in seconds (optional, default 120).
# TRACKER_LLM_TIMEOUT=120
