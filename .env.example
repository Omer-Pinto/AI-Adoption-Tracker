# AI Adoption Tracker — LLM adapter configuration
#
# All four TRACKER_LLM_* variables are REQUIRED.  Leaving any of them blank
# causes the report-draft endpoint to return HTTP 503 before making any
# network call.
#
# This deployment is AIR-GAPPED.  Every variable below points at the
# operator's own self-hosted server.  There are no public cloud endpoints,
# no hosted-model defaults, and no fallback to any external service.

# Wire-format dialect used to speak to the self-hosted model server.
# Must be exactly "openai" (OpenAI-compatible chat-completions API) or
# "anthropic" (Anthropic-compatible messages API).
TRACKER_LLM_PROVIDER=

# Full base URL of the air-gapped model server.
# Example (vLLM):     http://gpu-host.internal:8000/v1
# Example (Ollama):   http://localhost:11434/v1
# Example (LiteLLM):  http://llm-proxy.internal:4000
# No trailing slash.  The adapter appends /chat/completions or /messages.
TRACKER_LLM_ENDPOINT=

# Credential sent to the self-hosted server.
# OpenAI dialect:    sent as "Authorization: Bearer <key>"
# Anthropic dialect: sent as "x-api-key: <key>"
# Set to any non-empty string your server expects (or a dummy value if the
# server does not authenticate — the variable must still be non-empty).
TRACKER_LLM_API_KEY=

# Model name exactly as the self-hosted server expects it.
# Example (vLLM):     mistralai/Mistral-7B-Instruct-v0.3
# Example (Ollama):   llama3.1:8b-instruct-q5_K_M
# Example (LiteLLM):  gpt-4o   (mapped to your local model in the proxy)
TRACKER_LLM_MODEL=

# Request timeout in seconds (optional, default: 120).
# Increase for large models or slow hardware.
# TRACKER_LLM_TIMEOUT=120
