# =============================================================================
# AI Adoption Tracker — air-gap runtime configuration
# Copy this file to "env" (no extension) in the bundle root and fill it in:
#     cp env.example env  &&  nano env
# start.sh sources this file before launching the server.
# Keep it readable only by the service user: chmod 600 env
# =============================================================================

# ---- LLM adapter (required only for DRAFTING reports & extracting domains) ----
# All four TRACKER_LLM_* vars must be set for the draft/extract endpoints to
# work. Every other feature (teams, domains, tasks, artifacts, editing saved
# reports, search) works WITHOUT them. If unset, POST /api/reports/draft and
# POST /api/domains/extract return HTTP 503 with a clear message.

# Wire-format dialect spoken to your local vLLM server. EXACTLY one of:
#   openai     -> OpenAI-compatible /v1/chat/completions  (vLLM --api ... openai)
#   anthropic  -> Anthropic-compatible /v1/messages
TRACKER_LLM_PROVIDER=openai

# Base URL of the air-gapped vLLM server. NO trailing slash.
# The SDK appends the path itself (/chat/completions or /messages).
#   vLLM OpenAI server example:     http://gpu-host.internal:8000/v1
#   Anthropic-compatible proxy:     http://gpu-host.internal:8000
TRACKER_LLM_ENDPOINT=http://gpu-host.internal:8000/v1

# Credential sent to the server.
#   provider=openai     -> sent as  Authorization: Bearer <key>
#   provider=anthropic  -> sent as  x-api-key: <key>
# vLLM often runs with a single static key (--api-key ...). If your server does
# not authenticate, this must STILL be a non-empty string (e.g. "local").
TRACKER_LLM_API_KEY=local

# Model name EXACTLY as your vLLM server advertises it (the --served-model-name,
# or the HF repo id it was launched with).
TRACKER_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Request timeout in seconds (optional, default 120). Raise for slow hardware.
# TRACKER_LLM_TIMEOUT=120

# ---- Web server (this bundle) ----
# Interface to bind. 0.0.0.0 = reachable from the LAN; 127.0.0.1 = local only.
HOST=0.0.0.0
# Port that serves BOTH the UI and the /api backend (single origin).
PORT=8080
