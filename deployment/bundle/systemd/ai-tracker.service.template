# systemd unit template for the AI Adoption Tracker air-gap bundle.
#
# Install (as root):
#   1. Edit the three <PLACEHOLDERS> below.
#   2. cp ai-tracker.service.template /etc/systemd/system/ai-tracker.service
#   3. systemctl daemon-reload && systemctl enable --now ai-tracker
#   4. Logs:  journalctl -u ai-tracker -f
#
# This runs uvicorn in the FOREGROUND (no nohup/pidfile) — systemd supervises
# it. It does NOT use start.sh/stop.sh (those are for manual, non-systemd use).
# The EnvironmentFile supplies the same vars as the bundle's `env` file.

[Unit]
Description=AI Adoption Tracker (air-gapped)
After=network.target

[Service]
Type=simple
User=<SERVICE_USER>
WorkingDirectory=<BUNDLE_ROOT>/app
# Defaults first; the EnvironmentFile (listed after) overrides them if it sets
# HOST/PORT. This guarantees ${HOST}/${PORT} are never empty.
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=TRACKER_WEB_DIR=<BUNDLE_ROOT>/web
EnvironmentFile=<BUNDLE_ROOT>/env
ExecStart=<BUNDLE_ROOT>/.venv/bin/python -m uvicorn serve:app --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
